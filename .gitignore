# ============================================================
# Modbus OPC UA Gateway - Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Cursor / IDE
.cursor/
.vscode/
.idea/

# Build / packaging
build/
dist/
*.spec
*.egg-info/

# Runtime logs
logs/
*.log

# Runtime databases
data/*.db
data/*.sqlite
data/*.sqlite3

# Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary files
*.tmp
*.temp
*.bak

# Environment / secrets
.env
.env.*
secrets/

# Private OPC UA certificates / keys
certificates/own/*.key
certificates/own/*.pem
certificates/own/*.pfx
certificates/own/*.p12

# OPC UA generated/rejected runtime certificates
certificates/rejected/

# Windows
Thumbs.db
Desktop.ini

# OS temporary files
*.swp
*.swo

# Test/runtime output
coverage.xml
htmlcov/
.coverage